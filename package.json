{
  "name": "ai-game-hub",
  "productName": "AI Game Hub",
  "version": "0.1.0",
  "private": true,
  "description": "AI Game Hub phase 1: internal Windows UI prototype only",
  "main": "src/main/main.cjs",
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run build",
    "test:smoke": "npm run build && node tests/smoke.cjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "dev.aigamehub.desktop",
    "productName": "AI Game Hub (Internal Prototype)",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "src/main/**/*", "src/preload/**/*", "package.json"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
