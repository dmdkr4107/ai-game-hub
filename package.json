{
  "name": "ai-game-hub",
  "productName": "AI Game Hub",
  "version": "0.1.0",
  "private": true,
  "description": "AI Game Hub phase 1: internal Windows UI prototype only",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env AI_HUB_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run build",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "dev.aigamehub.desktop",
    "productName": "AI Game Hub (Internal Prototype)",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "src/main/**/*", "src/preload/**/*", "package.json"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
